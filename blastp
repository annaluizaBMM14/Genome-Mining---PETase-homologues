#!/bin/bash

PASTA_PROKKA="resultados_prokka_data"
BANCO_FA="$HOME/bdpet.fasta"
NOME_BANCO="bdpet"
PASTA_RESULTADOS="resultados_blastp_data"

mkdir -p "$PASTA_RESULTADOS"

if [ ! -f "${NOME_BANCO}.pin" ]; then
    echo "ðŸ”§ Criando banco BLAST..."
    makeblastdb -in "$BANCO_FA" -dbtype prot -out "$NOME_BANCO"
else
    echo "âœ… Banco BLAST jÃ¡ existe."
fi

for faa in "$PASTA_PROKKA"/*/*.faa; do
    # Nome do genoma = nome da subpasta
    genoma=$(basename "$(dirname "$faa")")

    echo "ðŸ”¬ Rodando BLAST para $genoma..."

    blastp -query "$faa" \
           -db "$NOME_BANCO" \
           -evalue 1e-5 \
           -out "${PASTA_RESULTADOS}/${genoma}_vs_bdpet.txt" \
           -outfmt 6
done

echo "âœ… Todos os resultados foram salvos na pasta: $PASTA_RESULTADOS"
